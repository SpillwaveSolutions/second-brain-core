{
  "description": "Fail-closed validate after knowledge writes. No SessionStart reminders.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/sbc-hook-validate.sh\"",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
